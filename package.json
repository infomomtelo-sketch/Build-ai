{
  "name": "jarvis-build-command",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "setup": "bash scripts/setup.sh",
    "db:migrate:local": "wrangler d1 migrations apply jarvis --local",
    "db:migrate": "wrangler d1 migrations apply jarvis --remote"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.62.1",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "wrangler": "^4.120.0"
  }
}
